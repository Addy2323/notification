// Prisma Schema for LUMO — Delivery Notification & Consumer Portal

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Merchant {
  id              String         @id @default(uuid())
  business_name   String
  business_phone  String
  email           String?
  location        String?
  logo_url        String?
  brand_color     String?        @default("#1E40AF")
  whatsapp_number String?
  status          String         @default("ACTIVE")
  created_at      DateTime       @default(now())

  users           MerchantUser[]
  deliveries      Delivery[]
  audit_logs      AuditLog[]
  customers       Customer[]
  drivers         Driver[]
  orders          Order[]
  products        Product[]
  reports         ReportRecord[]
  scores          MerchantScore[]
  achievements    MerchantAchievement[]
  analytics_events AnalyticsEvent[]

  @@map("merchants")
}

model MerchantUser {
  id              String    @id @default(uuid())
  merchant_id     String
  name            String
  phone           String    @unique
  email           String?   @unique
  avatar_url      String?
  role            String    @default("MERCHANT")
  password_hash   String?
  pin_hash        String?
  otp_code        String?
  otp_expires_at  DateTime?
  status          String    @default("ACTIVE")
  created_at      DateTime  @default(now())

  merchant        Merchant  @relation(fields: [merchant_id], references: [id], onDelete: Cascade)
  audit_logs      AuditLog[]

  @@map("merchant_users")
}

model Product {
  id           String      @id @default(uuid())
  merchant_id  String
  name         String
  description  String?
  sku          String?
  category     String?
  unit_price   Decimal     @db.Decimal(12, 2)
  cost_price   Decimal?    @db.Decimal(12, 2)
  status       String      @default("ACTIVE")
  created_at   DateTime    @default(now())

  merchant     Merchant    @relation(fields: [merchant_id], references: [id], onDelete: Cascade)
  order_items  OrderItem[]

  @@index([merchant_id])
  @@map("products")
}

model Customer {
  id               String    @id @default(uuid())
  merchant_id      String
  name             String
  phone            String
  email            String?
  delivery_address String?
  notes            String?
  created_at       DateTime  @default(now())

  merchant         Merchant  @relation(fields: [merchant_id], references: [id], onDelete: Cascade)
  orders           Order[]

  @@unique([merchant_id, phone])
  @@index([merchant_id])
  @@map("customers")
}

model Driver {
  id           String     @id @default(uuid())
  merchant_id  String
  name         String
  phone        String
  vehicle_info String?
  status       String     @default("AVAILABLE") // AVAILABLE, ON_DELIVERY, INACTIVE
  created_at   DateTime   @default(now())

  merchant     Merchant   @relation(fields: [merchant_id], references: [id], onDelete: Cascade)
  orders       Order[]

  @@unique([merchant_id, phone])
  @@index([merchant_id])
  @@map("drivers")
}

model Order {
  id                  String          @id @default(uuid())
  order_number        String          @unique
  merchant_id         String
  customer_id         String?
  customer_name       String
  customer_phone      String
  delivery_address    String
  product_name        String
  amount              Decimal?        @db.Decimal(12, 2)
  total_revenue       Decimal?        @db.Decimal(12, 2)
  total_cost          Decimal?        @db.Decimal(12, 2)
  gross_profit        Decimal?        @db.Decimal(12, 2)
  payment_status      String          @default("UNPAID")
  driver_id           String?
  driver_name         String?
  driver_phone        String?
  status              String          @default("PENDING")
  delivery_id         String?         @unique
  tracking_token      String?         @unique
  driver_token        String?         @unique
  created_at          DateTime        @default(now())
  updated_at          DateTime        @updatedAt
  confirmed_at        DateTime?
  assigned_at         DateTime?
  out_for_delivery_at DateTime?
  arrived_at          DateTime?
  delivered_at        DateTime?
  cancelled_at        DateTime?

  merchant            Merchant        @relation(fields: [merchant_id], references: [id], onDelete: Cascade)
  customer            Customer?       @relation(fields: [customer_id], references: [id], onDelete: SetNull)
  driver              Driver?         @relation(fields: [driver_id], references: [id], onDelete: SetNull)
  delivery            Delivery?       @relation(fields: [delivery_id], references: [id], onDelete: SetNull)
  items               OrderItem[]
  events              OrderEvent[]
  notifications       OrderNotification[]

  @@index([merchant_id])
  @@index([status])
  @@index([customer_phone])
  @@map("orders")
}

model OrderItem {
  id                           String   @id @default(uuid())
  order_id                     String
  product_id                   String?
  product_name_snapshot        String
  product_description_snapshot String?
  product_sku_snapshot         String?
  product_category_snapshot    String?
  unit_selling_price           Decimal  @db.Decimal(12, 2)
  unit_cost_price              Decimal? @db.Decimal(12, 2)
  quantity                     Int      @default(1)
  discount                     Decimal? @default(0) @db.Decimal(12, 2)
  subtotal                     Decimal  @db.Decimal(12, 2)
  profit_amount                Decimal? @db.Decimal(12, 2)
  created_at                   DateTime @default(now())

  order                        Order    @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product                      Product? @relation(fields: [product_id], references: [id], onDelete: SetNull)

  @@index([order_id])
  @@index([product_id])
  @@map("order_items")
}

model OrderEvent {
  id              String   @id @default(uuid())
  order_id        String
  event_type      String   // ORDER_CREATED, ORDER_CONFIRMED, DRIVER_ASSIGNED, OUT_FOR_DELIVERY, DRIVER_ARRIVED, ORDER_DELIVERED, ORDER_CANCELLED
  actor_type      String   // MERCHANT, DRIVER, SYSTEM
  actor_reference String?
  timestamp       DateTime @default(now())
  metadata        String?

  order           Order    @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@index([order_id])
  @@map("order_events")
}

model OrderNotification {
  id                  String    @id @default(uuid())
  order_id            String
  event_type          String
  recipient_type      String    // CUSTOMER, DRIVER
  recipient_phone     String
  message_body        String
  idempotency_key     String    @unique
  channel             String    @default("SMS")
  status              String    @default("QUEUED") // QUEUED, SENT, DELIVERED, FAILED
  provider_message_id String?
  sent_at             DateTime?
  delivered_at        DateTime?
  failed_at           DateTime?
  failure_reason      String?
  created_at          DateTime  @default(now())

  order               Order     @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@index([order_id])
  @@index([idempotency_key])
  @@map("order_notifications")
}

model Delivery {
  id                  String          @id @default(uuid())
  merchant_id         String
  customer_phone      String
  delivery_address    String
  product_description String
  driver_name         String
  driver_phone        String
  status              String          @default("CREATED")
  tracking_token      String          @unique
  driver_token        String          @unique
  created_at          DateTime        @default(now())
  started_at          DateTime?
  arrived_at          DateTime?
  delivered_at        DateTime?

  merchant            Merchant        @relation(fields: [merchant_id], references: [id], onDelete: Cascade)
  events              DeliveryEvent[]
  notifications       Notification[]
  order               Order?

  @@index([merchant_id])
  @@index([status])
  @@index([customer_phone])
  @@map("deliveries")
}

model DeliveryEvent {
  id                 String         @id @default(uuid())
  delivery_id        String
  event_type         String
  actor_type         String
  actor_reference    String?
  timestamp          DateTime       @default(now())
  metadata           String?
  ip_address         String?
  device_information String?

  delivery           Delivery       @relation(fields: [delivery_id], references: [id], onDelete: Cascade)
  notifications      Notification[]

  @@index([delivery_id])
  @@map("delivery_events")
}

model Notification {
  id                  String         @id @default(uuid())
  delivery_id         String
  event_id            String?
  channel             String         @default("SMS")
  recipient           String
  template_id         String?
  provider_message_id String?
  status              String         @default("QUEUED")
  sent_at             DateTime?
  delivered_at        DateTime?
  read_at             DateTime?
  failed_at           DateTime?
  failure_reason      String?

  delivery            Delivery       @relation(fields: [delivery_id], references: [id], onDelete: Cascade)
  event               DeliveryEvent? @relation(fields: [event_id], references: [id], onDelete: SetNull)

  @@index([delivery_id])
  @@index([status])
  @@map("notifications")
}

model NotificationTemplate {
  id             String   @id @default(uuid())
  event_type     String
  channel        String   @default("SMS")
  language       String   @default("en")
  body           String
  active_version Int      @default(1)
  created_at     DateTime @default(now())

  @@map("notification_templates")
}

model AuditLog {
  id          String   @id @default(uuid())
  merchant_id String?
  user_id     String?
  admin_id    String?
  action      String
  object_type String
  object_id   String?
  timestamp   DateTime @default(now())
  metadata    String?

  merchant    Merchant?     @relation(fields: [merchant_id], references: [id], onDelete: SetNull)
  user        MerchantUser? @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model ReportRecord {
  id           String   @id @default(uuid())
  merchant_id  String
  user_id      String?
  report_type  String
  format       String
  start_date   DateTime
  end_date     DateTime
  summary_json String?
  file_url     String?
  created_at   DateTime @default(now())

  merchant     Merchant @relation(fields: [merchant_id], references: [id], onDelete: Cascade)

  @@index([merchant_id])
  @@map("report_records")
}

model AnalyticsEvent {
  id                   String    @id @default(uuid())
  event_type           String    // PAGE_VIEW, LANDING_PAGE_VIEW, TRACKING_PAGE_VIEW, REGISTER_PAGE_VIEW, REGISTER_STARTED, REGISTER_COMPLETED, LOGIN, ORDER_CREATED, DELIVERY_TRACKED
  session_id           String?
  anonymous_visitor_id String?
  merchant_id          String?
  page                 String?
  referrer             String?
  device_type          String?
  browser              String?
  operating_system     String?
  ip_address           String?
  metadata             String?
  created_at           DateTime  @default(now())

  merchant             Merchant? @relation(fields: [merchant_id], references: [id], onDelete: SetNull)

  @@index([event_type])
  @@index([merchant_id])
  @@index([created_at])
  @@map("analytics_events")
}

model MerchantScore {
  id                 String   @id @default(uuid())
  merchant_id        String
  score              Float    @default(0)
  order_score        Float    @default(0)
  completion_score   Float    @default(0)
  consistency_score  Float    @default(0)
  driver_score       Float    @default(0)
  notification_score Float    @default(0)
  period             String   @default("ALL_TIME")
  active_days        Int      @default(0)
  orders_count       Int      @default(0)
  completion_rate    Float    @default(0)
  calculated_at      DateTime @default(now())

  merchant           Merchant @relation(fields: [merchant_id], references: [id], onDelete: Cascade)

  @@index([merchant_id])
  @@index([score])
  @@map("merchant_scores")
}

model MerchantAchievement {
  id               String   @id @default(uuid())
  merchant_id      String
  achievement_key  String   // FIRST_10_ORDERS, 100_ORDERS, 500_ORDERS, 1000_ORDERS, CONSISTENCY_30, DELIVERY_EXCELLENCE
  title            String
  description      String
  badge_icon       String   @default("trophy")
  granted_by       String   @default("SYSTEM") // SYSTEM or Admin User ID
  granted_at       DateTime @default(now())

  merchant         Merchant @relation(fields: [merchant_id], references: [id], onDelete: Cascade)

  @@index([merchant_id])
  @@map("merchant_achievements")
}

model SystemIncident {
  id             String    @id @default(uuid())
  service_name   String    // API, DB, SMS_PROVIDER, QUEUE, BACKGROUND_JOBS
  error_type     String
  severity       String    @default("WARNING") // INFO, WARNING, CRITICAL
  description    String
  merchant_id    String?
  order_id       String?
  status         String    @default("OPEN") // OPEN, INVESTIGATING, RESOLVED
  metadata       String?
  created_at     DateTime  @default(now())
  resolved_at    DateTime?

  @@index([service_name])
  @@index([status])
  @@map("system_incidents")
}

model AlertThreshold {
  id               String   @id @default(uuid())
  key              String   @unique // DELIVERY_FAILURE_RATE, SMS_FAILURE_RATE, QUEUE_DEPTH, API_ERROR_RATE, TRAFFIC_SPIKE
  name             String
  threshold_value  Float
  metric_unit      String   @default("%")
  is_active        Boolean  @default(true)
  notify_channels  String   @default("ADMIN_DASHBOARD")
  updated_at       DateTime @updatedAt

  @@map("alert_thresholds")
}

