// Prisma Schema for LUMO — Delivery Notification & Consumer Portal

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Merchant {
  id              String         @id @default(uuid())
  business_name   String
  business_phone  String
  email           String?
  website         String?
  location        String?
  logo_url        String?
  brand_color     String?        @default("#1E40AF")
  whatsapp_number String?
  status          String         @default("ACTIVE")
  verification_status     String   @default("NOT_VERIFIED") // NOT_VERIFIED, PAYMENT_PENDING, PAID_PENDING_REVIEW, VERIFIED, REJECTED, EXPIRED, SUSPENDED
  is_verified             Boolean  @default(false)
  verified_at             DateTime?
  verification_expires_at DateTime?
  created_at      DateTime       @default(now())

  users           MerchantUser[]
  deliveries      Delivery[]
  audit_logs      AuditLog[]
  customers       Customer[]
  drivers         Driver[]
  orders          Order[]
  products        Product[]
  reports         ReportRecord[]
  scores          MerchantScore[]
  achievements    MerchantAchievement[]
  analytics_events AnalyticsEvent[]
  ratings          CustomerRating[]
  receipt_confirmations OrderReceiptConfirmation[]
  confirmation_receipts ConfirmationReceipt[]
  sms_account           MerchantSmsAccount?
  sms_ledgers           SmsCreditLedger[]
  sms_topups            SmsTopupTransaction[]
  store                 MerchantStore?
  store_categories      StoreCategory[]
  store_analytics       StoreAnalyticsEvent[]
  store_enquiries       StoreProductEnquiry[]
  store_sms_logs        StoreSmsDispatchLog[]
  category_mappings     MerchantCategoryMapping[]
  followers             MerchantFollower[]
  posts                 MerchantPost[]
  verification_applications VerificationApplication[]
  sms_templates         SmsTemplate[]
  sms_campaigns         SmsCampaign[]
  sms_campaign_recipients SmsCampaignRecipient[]
  merchant_notifications MerchantNotification[]

  @@index([is_verified])
  @@index([verification_status])
  @@map("merchants")
}

model MerchantUser {
  id              String    @id @default(uuid())
  merchant_id     String
  name            String
  phone           String    @unique
  email           String?   @unique
  language        String    @default("en")
  avatar_url      String?
  role            String    @default("MERCHANT")
  password_hash   String?
  pin_hash        String?
  otp_code        String?
  otp_expires_at  DateTime?
  status          String    @default("ACTIVE")
  created_at      DateTime  @default(now())

  merchant        Merchant  @relation(fields: [merchant_id], references: [id], onDelete: Cascade)
  audit_logs      AuditLog[]

  @@map("merchant_users")
}

model Product {
  id                  String      @id @default(uuid())
  merchant_id         String
  name                String
  slug                String?
  description         String?
  sku                 String?
  category            String?
  brand               String?
  currency            String      @default("TZS")
  unit_price          Decimal     @db.Decimal(12, 2)
  cost_price          Decimal?    @db.Decimal(12, 2)
  promotional_price   Decimal?    @db.Decimal(12, 2)
  promotion_start_at  DateTime?
  promotion_end_at    DateTime?
  available_quantity  Int         @default(0)
  track_inventory     Boolean     @default(false)
  stock_status        String      @default("IN_STOCK")
  low_stock_threshold Int         @default(5)
  publication_status  String      @default("DRAFT")
  is_featured         Boolean     @default(false)
  primary_image_url   String?
  images_json         String?
  variants_json       String?
  status              String      @default("ACTIVE")
  created_at          DateTime    @default(now())
  updated_at          DateTime    @default(now()) @updatedAt

  merchant            Merchant    @relation(fields: [merchant_id], references: [id], onDelete: Cascade)
  order_items         OrderItem[]
  store_analytics     StoreAnalyticsEvent[]
  store_enquiries     StoreProductEnquiry[]

  @@index([merchant_id])
  @@index([merchant_id, publication_status])
  @@map("products")
}

model Customer {
  id                       String    @id @default(uuid())
  merchant_id              String
  name                     String
  phone                    String
  email                    String?
  delivery_address         String?
  notes                    String?
  marketing_opt_in         Boolean   @default(false)
  marketing_opt_in_at      DateTime?
  marketing_opt_out_at     DateTime?
  marketing_consent_source String?
  created_at               DateTime  @default(now())

  merchant                 Merchant  @relation(fields: [merchant_id], references: [id], onDelete: Cascade)
  orders                   Order[]
  store_sms_logs           StoreSmsDispatchLog[]

  @@unique([merchant_id, phone])
  @@index([merchant_id])
  @@map("customers")
}

model Driver {
  id           String     @id @default(uuid())
  merchant_id  String
  name         String
  phone        String
  vehicle_info String?
  status       String     @default("AVAILABLE") // AVAILABLE, ON_DELIVERY, INACTIVE
  created_at   DateTime   @default(now())

  merchant     Merchant   @relation(fields: [merchant_id], references: [id], onDelete: Cascade)
  orders       Order[]
  ratings      CustomerRating[]

  @@unique([merchant_id, phone])
  @@index([merchant_id])
  @@map("drivers")
}

model Order {
  id                  String          @id @default(uuid())
  order_number        String          @unique
  merchant_id         String
  customer_id         String?
  customer_name       String
  customer_phone      String
  delivery_address    String
  product_name        String
  image_url           String?
  amount              Decimal?        @db.Decimal(12, 2)
  total_revenue       Decimal?        @db.Decimal(12, 2)
  total_cost          Decimal?        @db.Decimal(12, 2)
  gross_profit        Decimal?        @db.Decimal(12, 2)
  delivery_fee        Decimal?        @default(0) @db.Decimal(12, 2)
  discount_amount     Decimal?        @default(0) @db.Decimal(12, 2)
  tax_amount          Decimal?        @default(0) @db.Decimal(12, 2)
  amount_paid         Decimal?        @default(0) @db.Decimal(12, 2)
  currency            String          @default("TZS")
  transaction_reference String?
  payment_status      String          @default("UNPAID")
  driver_id           String?
  driver_name         String?
  driver_phone        String?
  vehicle_info        String?
  status              String          @default("PENDING")
  delivery_id         String?         @unique
  tracking_token      String?         @unique
  driver_token        String?         @unique
  rating_token        String?         @unique
  receipt_confirmation_token String?  @unique
  receipt_status      String?         @default("AWAITING_RESPONSE")
  created_at          DateTime        @default(now())
  updated_at          DateTime        @updatedAt
  confirmed_at        DateTime?
  assigned_at         DateTime?
  out_for_delivery_at DateTime?
  arrived_at          DateTime?
  delivered_at        DateTime?
  completed_at        DateTime?
  cancelled_at        DateTime?

  merchant            Merchant        @relation(fields: [merchant_id], references: [id], onDelete: Cascade)
  customer            Customer?       @relation(fields: [customer_id], references: [id], onDelete: SetNull)
  driver              Driver?         @relation(fields: [driver_id], references: [id], onDelete: SetNull)
  delivery            Delivery?       @relation(fields: [delivery_id], references: [id], onDelete: SetNull)
  items               OrderItem[]
  events              OrderEvent[]
  notifications       OrderNotification[]
  merchant_notifications MerchantNotification[]
  rating              CustomerRating?
  receipt_confirmation OrderReceiptConfirmation?
  confirmation_receipt ConfirmationReceipt?

  @@index([merchant_id])
  @@index([status])
  @@index([customer_phone])
  @@map("orders")
}

model OrderItem {
  id                           String   @id @default(uuid())
  order_id                     String
  product_id                   String?
  product_name_snapshot        String
  product_description_snapshot String?
  product_sku_snapshot         String?
  product_category_snapshot    String?
  unit_selling_price           Decimal  @db.Decimal(12, 2)
  unit_cost_price              Decimal? @db.Decimal(12, 2)
  quantity                     Int      @default(1)
  discount                     Decimal? @default(0) @db.Decimal(12, 2)
  subtotal                     Decimal  @db.Decimal(12, 2)
  profit_amount                Decimal? @db.Decimal(12, 2)
  created_at                   DateTime @default(now())

  order                        Order    @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product                      Product? @relation(fields: [product_id], references: [id], onDelete: SetNull)

  @@index([order_id])
  @@index([product_id])
  @@map("order_items")
}

model OrderEvent {
  id              String   @id @default(uuid())
  order_id        String
  event_type      String   // ORDER_CREATED, ORDER_CONFIRMED, DRIVER_ASSIGNED, OUT_FOR_DELIVERY, DRIVER_ARRIVED, ORDER_DELIVERED, ORDER_CANCELLED
  actor_type      String   // MERCHANT, DRIVER, SYSTEM
  actor_reference String?
  timestamp       DateTime @default(now())
  metadata        String?

  order           Order    @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@index([order_id])
  @@map("order_events")
}

model OrderNotification {
  id                  String    @id @default(uuid())
  order_id            String
  event_type          String
  recipient_type      String    // CUSTOMER, DRIVER
  recipient_phone     String
  message_body        String
  idempotency_key     String    @unique
  channel             String    @default("SMS")
  status              String    @default("QUEUED") // QUEUED, SENT, DELIVERED, FAILED
  provider_message_id String?
  sent_at             DateTime?
  delivered_at        DateTime?
  failed_at           DateTime?
  failure_reason      String?
  created_at          DateTime  @default(now())

  order               Order     @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@index([order_id])
  @@index([idempotency_key])
  @@map("order_notifications")
}

model Delivery {
  id                  String          @id @default(uuid())
  merchant_id         String
  customer_phone      String
  delivery_address    String
  product_description String
  driver_name         String
  driver_phone        String
  status              String          @default("CREATED")
  tracking_token      String          @unique
  driver_token        String          @unique
  created_at          DateTime        @default(now())
  started_at          DateTime?
  arrived_at          DateTime?
  delivered_at        DateTime?

  merchant            Merchant        @relation(fields: [merchant_id], references: [id], onDelete: Cascade)
  events              DeliveryEvent[]
  notifications       Notification[]
  order               Order?

  @@index([merchant_id])
  @@index([status])
  @@index([customer_phone])
  @@map("deliveries")
}

model DeliveryEvent {
  id                 String         @id @default(uuid())
  delivery_id        String
  event_type         String
  actor_type         String
  actor_reference    String?
  timestamp          DateTime       @default(now())
  metadata           String?
  ip_address         String?
  device_information String?

  delivery           Delivery       @relation(fields: [delivery_id], references: [id], onDelete: Cascade)
  notifications      Notification[]

  @@index([delivery_id])
  @@map("delivery_events")
}

model Notification {
  id                  String         @id @default(uuid())
  delivery_id         String
  event_id            String?
  channel             String         @default("SMS")
  recipient           String
  template_id         String?
  provider_message_id String?
  status              String         @default("QUEUED")
  sent_at             DateTime?
  delivered_at        DateTime?
  read_at             DateTime?
  failed_at           DateTime?
  failure_reason      String?

  delivery            Delivery       @relation(fields: [delivery_id], references: [id], onDelete: Cascade)
  event               DeliveryEvent? @relation(fields: [event_id], references: [id], onDelete: SetNull)

  @@index([delivery_id])
  @@index([status])
  @@map("notifications")
}

model NotificationTemplate {
  id             String   @id @default(uuid())
  event_type     String
  channel        String   @default("SMS")
  language       String   @default("en")
  body           String
  active_version Int      @default(1)
  created_at     DateTime @default(now())

  @@map("notification_templates")
}

model AuditLog {
  id          String   @id @default(uuid())
  merchant_id String?
  user_id     String?
  admin_id    String?
  action      String
  object_type String
  object_id   String?
  timestamp   DateTime @default(now())
  metadata    String?

  merchant    Merchant?     @relation(fields: [merchant_id], references: [id], onDelete: SetNull)
  user        MerchantUser? @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model ReportRecord {
  id           String   @id @default(uuid())
  merchant_id  String
  user_id      String?
  report_type  String
  format       String
  start_date   DateTime
  end_date     DateTime
  summary_json String?
  file_url     String?
  created_at   DateTime @default(now())

  merchant     Merchant @relation(fields: [merchant_id], references: [id], onDelete: Cascade)

  @@index([merchant_id])
  @@map("report_records")
}

model AnalyticsEvent {
  id                   String    @id @default(uuid())
  event_type           String    // PAGE_VIEW, LANDING_PAGE_VIEW, TRACKING_PAGE_VIEW, REGISTER_PAGE_VIEW, REGISTER_STARTED, REGISTER_COMPLETED, LOGIN, ORDER_CREATED, DELIVERY_TRACKED
  session_id           String?
  anonymous_visitor_id String?
  merchant_id          String?
  page                 String?
  referrer             String?
  device_type          String?
  browser              String?
  operating_system     String?
  ip_address           String?
  metadata             String?
  created_at           DateTime  @default(now())

  merchant             Merchant? @relation(fields: [merchant_id], references: [id], onDelete: SetNull)

  @@index([event_type])
  @@index([merchant_id])
  @@index([created_at])
  @@map("analytics_events")
}

model MerchantScore {
  id                 String   @id @default(uuid())
  merchant_id        String
  score              Float    @default(0)
  order_score        Float    @default(0)
  completion_score   Float    @default(0)
  consistency_score  Float    @default(0)
  driver_score       Float    @default(0)
  notification_score Float    @default(0)
  period             String   @default("ALL_TIME")
  active_days        Int      @default(0)
  orders_count       Int      @default(0)
  completion_rate    Float    @default(0)
  calculated_at      DateTime @default(now())

  merchant           Merchant @relation(fields: [merchant_id], references: [id], onDelete: Cascade)

  @@index([merchant_id])
  @@index([score])
  @@map("merchant_scores")
}

model MerchantAchievement {
  id               String   @id @default(uuid())
  merchant_id      String
  achievement_key  String   // FIRST_10_ORDERS, 100_ORDERS, 500_ORDERS, 1000_ORDERS, CONSISTENCY_30, DELIVERY_EXCELLENCE
  title            String
  description      String
  badge_icon       String   @default("trophy")
  granted_by       String   @default("SYSTEM") // SYSTEM or Admin User ID
  granted_at       DateTime @default(now())

  merchant         Merchant @relation(fields: [merchant_id], references: [id], onDelete: Cascade)

  @@index([merchant_id])
  @@map("merchant_achievements")
}

model SystemIncident {
  id             String    @id @default(uuid())
  service_name   String    // API, DB, SMS_PROVIDER, QUEUE, BACKGROUND_JOBS
  error_type     String
  severity       String    @default("WARNING") // INFO, WARNING, CRITICAL
  description    String
  merchant_id    String?
  order_id       String?
  status         String    @default("OPEN") // OPEN, INVESTIGATING, RESOLVED
  metadata       String?
  created_at     DateTime  @default(now())
  resolved_at    DateTime?

  @@index([service_name])
  @@index([status])
  @@map("system_incidents")
}

model AlertThreshold {
  id               String   @id @default(uuid())
  key              String   @unique // DELIVERY_FAILURE_RATE, SMS_FAILURE_RATE, QUEUE_DEPTH, API_ERROR_RATE, TRAFFIC_SPIKE
  name             String
  threshold_value  Float
  metric_unit      String   @default("%")
  is_active        Boolean  @default(true)
  notify_channels  String   @default("ADMIN_DASHBOARD")
  updated_at       DateTime @updatedAt

  @@map("alert_thresholds")
}

model CustomerRating {
  id           String   @id @default(uuid())
  order_id     String   @unique
  merchant_id  String
  driver_id    String?
  rating_token String   @unique @default(uuid())
  rating       Int      // 1 to 5
  comment      String?
  created_at   DateTime @default(now())

  order        Order    @relation(fields: [order_id], references: [id], onDelete: Cascade)
  merchant     Merchant @relation(fields: [merchant_id], references: [id], onDelete: Cascade)
  driver       Driver?  @relation(fields: [driver_id], references: [id], onDelete: SetNull)

  @@index([merchant_id])
  @@index([driver_id])
  @@index([rating])
  @@map("customer_ratings")
}

model OrderReceiptConfirmation {
  id                   String    @id @default(uuid())
  order_id             String    @unique
  merchant_id          String
  confirmation_token   String    @unique
  sms_status           String    @default("QUEUED") // QUEUED, SENT, DELIVERED, FAILED
  sms_sent_at          DateTime?
  sms_delivered_at     DateTime?
  sms_message_id       String?
  sms_failure_reason   String?
  sms_type             String    @default("AUTOMATIC") // AUTOMATIC, RESENT
  customer_response    String?   // RECEIVED, NOT_RECEIVED
  responded_at         DateTime?
  response_channel     String?   @default("WEB")
  ip_address           String?
  user_agent           String?
  followup_status      String?   // OPEN, INVESTIGATING, RESOLVED, CLOSED
  assigned_staff       String?
  investigation_notes  String?   // JSON string of array [{ id, author, role, text, created_at }]
  resolution_notes     String?
  resolved_at          DateTime?
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt

  order                Order     @relation(fields: [order_id], references: [id], onDelete: Cascade)
  merchant             Merchant  @relation(fields: [merchant_id], references: [id], onDelete: Cascade)

  @@index([merchant_id])
  @@index([confirmation_token])
  @@index([customer_response])
  @@index([followup_status])
  @@map("order_receipt_confirmations")
}

model ReceiptConfirmationSetting {
  id                    String   @id @default("default")
  auto_confirm_enabled  Boolean  @default(true)
  send_delay_seconds    Int      @default(0)
  reminder_enabled      Boolean  @default(false)
  reminder_delay_hours  Int      @default(24)
  max_reminders         Int      @default(1)
  template_en           String   @default("Hello {{customerName}}, have you received your order #{{orderNumber}}? Please confirm here: {{confirmationLink}}")
  template_sw           String   @default("Habari {{customerName}}, umepokea oda yako #{{orderNumber}}? Tafadhali thibitisha hapa: {{confirmationLink}}")
  thank_you_en          String   @default("Thank you for shopping with us! We're glad you received your order. We appreciate your support.")
  thank_you_sw          String   @default("Asante kwa kufanya manunuzi nasi! Tunafurahi kuwa umepokea oda yako. Tunathamini uaminifu wako.")
  investigation_en      String   @default("We're sorry you haven't received your order. We're checking your order now and will get back to you shortly.")
  investigation_sw      String   @default("Pole kwa kuwa bado hujapokea oda yako. Tunaifuatilia oda yako sasa na tutakujulisha hivi karibuni.")
  updated_at            DateTime @updatedAt

  @@map("receipt_confirmation_settings")
}

model MerchantSmsAccount {
  id                      String    @id @default(uuid())
  merchant_id             String    @unique
  available_credits       Int       @default(0)
  total_purchased         Int       @default(0)
  total_consumed          Int       @default(0)
  total_extended          Int       @default(0)
  balance_reference_units Int       @default(0)
  created_at              DateTime  @default(now())
  updated_at              DateTime  @updatedAt

  merchant                Merchant  @relation(fields: [merchant_id], references: [id], onDelete: Cascade)

  @@map("merchant_sms_accounts")
}

model SmsCreditLedger {
  id             String    @id @default(uuid())
  merchant_id    String
  amount         Int       // Positive for additions, negative for deductions
  type           String    // PURCHASE, ADMIN_EXTENSION, MANUAL_APPROVAL, ADMIN_REVERSAL, USAGE_DEDUCTION, REFUND
  balance_before Int
  balance_after  Int
  reference      String?
  reason         String
  admin_id       String?
  created_at     DateTime  @default(now())

  merchant       Merchant  @relation(fields: [merchant_id], references: [id], onDelete: Cascade)

  @@index([merchant_id])
  @@index([type])
  @@index([created_at])
  @@map("sms_credit_ledgers")
}

model SmsTopupTransaction {
  id                 String    @id @default(uuid())
  reference          String    @unique
  merchant_id        String
  requested_units    Int
  unit_price         Int       @default(20)
  total_amount       Int       // In TZS (requested_units * unit_price)
  payment_status     String    @default("PENDING") // PENDING, COMPLETED, FAILED, CANCELLED, EXPIRED
  allocated          Boolean   @default(false)
  allocated_at       DateTime?
  gateway_provider   String    @default("SNIPPE")
  gateway_reference  String?
  gateway_session_id String?
  checkout_url       String?
  payment_link_url   String?
  customer_phone     String?
  metadata           String?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  merchant           Merchant  @relation(fields: [merchant_id], references: [id], onDelete: Cascade)

  @@index([merchant_id])
  @@index([reference])
  @@index([payment_status])
  @@map("sms_topup_transactions")
}

model SmsGlobalSetting {
  id                         String    @id @default("default")
  unit_price_tzs             Int       @default(20)
  min_units                  Int       @default(25)
  max_units                  Int       @default(500000)
  admin_alert_phones         String    @default("[\"0768828247\",\"0711788830\"]")
  auto_sync_enabled          Boolean   @default(true)
  last_provider_sync_at      DateTime?
  provider_api_key           String?
  provider_account_name      String?   @default("Meseji SMS")
  provider_balance_raw       String?
  provider_balance_units     Int?
  provider_balance_currency  String?   @default("TZS")
  provider_balance_amount    Float?
  provider_status            String?   @default("CONNECTED")
  provider_metrics_json      String?
  updated_at                 DateTime  @updatedAt

  @@map("sms_global_settings")
}

model SmsProviderMessageRecord {
  id                  String    @id @default(uuid())
  provider_message_id String    @unique
  merchant_id         String?
  recipient           String
  message_body        String?
  status              String    @default("PENDING") // PENDING, DELIVERED, FAILED
  units_billed        Int       @default(1)
  cost                Decimal?  @db.Decimal(10, 2)
  sent_at             DateTime?
  delivered_at        DateTime?
  created_at          DateTime  @default(now())

  @@index([status])
  @@index([merchant_id])
  @@index([sent_at])
  @@map("sms_provider_message_records")
}

model ConfirmationReceipt {
  id                      String    @id @default(uuid())
  receipt_number          String    @unique
  order_id                String    @unique
  merchant_id             String
  customer_id             String?
  access_token_hash       String    @unique
  public_token            String    @unique
  status                  String    @default("GENERATED") // PENDING, GENERATED, FAILED, REVOKED
  payment_status_snapshot String    @default("UNPAID") // PAID, PARTIALLY PAID, UNPAID, REFUNDED
  currency                String    @default("TZS")
  subtotal                Decimal   @db.Decimal(12, 2)
  discount_total          Decimal   @default(0) @db.Decimal(12, 2)
  delivery_charges        Decimal   @default(0) @db.Decimal(12, 2)
  tax_total               Decimal   @default(0) @db.Decimal(12, 2)
  grand_total             Decimal   @db.Decimal(12, 2)
  amount_paid             Decimal   @default(0) @db.Decimal(12, 2)
  outstanding_balance     Decimal   @db.Decimal(12, 2)
  transaction_reference   String?
  pdf_storage_path        String?
  pdf_size_bytes          Int?
  generated_at            DateTime  @default(now())
  order_completed_at      DateTime  @default(now())
  expires_at              DateTime?
  revoked_at              DateTime?
  revoked_by              String?
  revocation_reason       String?
  sms_status              String    @default("SMS_PENDING") // SMS_PENDING, SMS_SENT, SMS_DELIVERED, SMS_FAILED
  sms_recipient_phone     String
  sms_message_body        String?
  sms_provider_message_id String?
  sms_provider_response   String?
  sms_sent_at             DateTime?
  sms_delivered_at        DateTime?
  sms_failed_at           DateTime?
  sms_failure_reason      String?
  sms_retry_count         Int       @default(0)
  sms_retry_history       String?
  generation_error        String?
  created_at              DateTime  @default(now())
  updated_at              DateTime  @updatedAt

  order                   Order     @relation(fields: [order_id], references: [id], onDelete: Cascade)
  merchant                Merchant  @relation(fields: [merchant_id], references: [id], onDelete: Cascade)

  @@index([merchant_id])
  @@index([status])
  @@index([sms_status])
  @@index([created_at])
  @@map("confirmation_receipts")
}

model MerchantStore {
  id                               String    @id @default(uuid())
  merchant_id                      String    @unique
  store_name                       String
  slug                             String    @unique
  previous_slugs                   String?   // JSON string array of previously published slugs for redirects
  description                      String?
  logo_url                         String?
  cover_image_url                  String?
  primary_color                    String    @default("#0F172A")
  secondary_color                  String    @default("#FF5500")
  contact_phone                    String?
  whatsapp_number                  String?
  contact_email                    String?
  location                         String?
  social_links_json                String?
  promotional_banner_text          String?
  show_sold_out_badges             Boolean   @default(true)
  show_on_tracking_page            Boolean   @default(true)
  include_link_in_transactional_sms Boolean  @default(false)
  store_sms_template               String    @default("Hello [Customer Name], explore more products from [Business Name]. View our available products here: [Store Link]. Thank you for shopping with us!")
  publication_status               String    @default("DRAFT") // DRAFT, PUBLISHED, SUSPENDED
  suspension_reason                String?
  suspended_at                     DateTime?
  suspended_by                     String?
  published_at                     DateTime?
  created_at                       DateTime  @default(now())
  updated_at                       DateTime  @updatedAt

  merchant                         Merchant  @relation(fields: [merchant_id], references: [id], onDelete: Cascade)
  categories                       StoreCategory[]
  analytics_events                 StoreAnalyticsEvent[]
  enquiries                        StoreProductEnquiry[]
  sms_logs                         StoreSmsDispatchLog[]

  @@index([publication_status])
  @@map("merchant_stores")
}

model StoreCategory {
  id            String        @id @default(uuid())
  store_id      String
  merchant_id   String
  name          String
  slug          String
  description   String?
  display_order Int           @default(0)
  status        String        @default("ACTIVE")
  created_at    DateTime      @default(now())

  store         MerchantStore @relation(fields: [store_id], references: [id], onDelete: Cascade)
  merchant      Merchant      @relation(fields: [merchant_id], references: [id], onDelete: Cascade)

  @@unique([store_id, slug])
  @@index([merchant_id])
  @@map("store_categories")
}

model StoreAnalyticsEvent {
  id          String        @id @default(uuid())
  store_id    String
  merchant_id String
  product_id  String?
  order_id    String?
  event_type  String        // STORE_VIEW, PRODUCT_VIEW, STORE_LINK_CLICK, WHATSAPP_CLICK, CALL_CLICK, PRODUCT_ENQUIRY, STOREFRONT_ORDER_REQUEST, BUY_AGAIN_ORDER_REQUEST, TRACKING_RECOMMENDATION_CLICK
  visitor_id  String?
  referrer    String?
  metadata    String?
  created_at  DateTime      @default(now())

  store       MerchantStore @relation(fields: [store_id], references: [id], onDelete: Cascade)
  merchant    Merchant      @relation(fields: [merchant_id], references: [id], onDelete: Cascade)
  product     Product?      @relation(fields: [product_id], references: [id], onDelete: SetNull)

  @@index([store_id, event_type])
  @@index([merchant_id, created_at])
  @@index([product_id])
  @@map("store_analytics_events")
}

model StoreProductEnquiry {
  id               String        @id @default(uuid())
  store_id         String
  merchant_id      String
  product_id       String?
  order_id         String?
  customer_name    String
  customer_phone   String
  delivery_address String?
  quantity         Int           @default(1)
  selected_variant String?
  message          String?
  enquiry_type     String        @default("ORDER_REQUEST") // ORDER_REQUEST, ENQUIRY, BUY_AGAIN
  status           String        @default("NEW") // NEW, CONTACTED, CONVERTED_TO_ORDER, CLOSED
  created_at       DateTime      @default(now())

  store            MerchantStore @relation(fields: [store_id], references: [id], onDelete: Cascade)
  merchant         Merchant      @relation(fields: [merchant_id], references: [id], onDelete: Cascade)
  product          Product?      @relation(fields: [product_id], references: [id], onDelete: SetNull)

  @@index([store_id, status])
  @@index([merchant_id, created_at])
  @@map("store_product_enquiries")
}

model StoreSmsDispatchLog {
  id                  String        @id @default(uuid())
  store_id            String
  merchant_id         String
  customer_id         String?
  recipient_name      String?
  recipient_phone     String
  store_url           String
  message_body        String
  status              String        @default("QUEUED") // QUEUED, SENT, DELIVERED, FAILED
  units_billed        Int           @default(1)
  provider_message_id String?
  provider_response   String?
  failure_reason      String?
  sent_at             DateTime?
  delivered_at        DateTime?
  created_at          DateTime      @default(now())

  store               MerchantStore @relation(fields: [store_id], references: [id], onDelete: Cascade)
  merchant            Merchant      @relation(fields: [merchant_id], references: [id], onDelete: Cascade)
  customer            Customer?     @relation(fields: [customer_id], references: [id], onDelete: SetNull)

  @@index([merchant_id, created_at])
  @@index([provider_message_id])
  @@map("store_sms_dispatch_logs")
}

// ================= MERCHANT MARKETPLACE, VERIFICATION & BULK SMS =================

model MerchantCategory {
  id            String                    @id @default(uuid())
  name          String
  slug          String                    @unique
  description   String?
  image_url     String?
  icon_name     String?
  parent_id     String?
  display_order Int                       @default(0)
  is_active     Boolean                   @default(true)
  created_at    DateTime                  @default(now())
  updated_at    DateTime                  @updatedAt

  parent        MerchantCategory?         @relation("CategoryHierarchy", fields: [parent_id], references: [id], onDelete: Cascade)
  subcategories MerchantCategory[]        @relation("CategoryHierarchy")
  merchants     MerchantCategoryMapping[]

  @@index([parent_id])
  @@index([is_active, display_order])
  @@map("merchant_categories")
}

model MerchantCategoryMapping {
  id          String           @id @default(uuid())
  merchant_id String
  category_id String
  is_primary  Boolean          @default(false)
  created_at  DateTime         @default(now())

  merchant    Merchant         @relation(fields: [merchant_id], references: [id], onDelete: Cascade)
  category    MerchantCategory @relation(fields: [category_id], references: [id], onDelete: Cascade)

  @@unique([merchant_id, category_id])
  @@index([category_id])
  @@map("merchant_category_mappings")
}

model MerchantFollower {
  id            String   @id @default(uuid())
  merchant_id   String
  follower_key  String
  user_id       String?
  follower_name String?
  created_at    DateTime @default(now())

  merchant      Merchant @relation(fields: [merchant_id], references: [id], onDelete: Cascade)

  @@unique([merchant_id, follower_key])
  @@index([merchant_id])
  @@map("merchant_followers")
}

model MerchantPost {
  id           String   @id @default(uuid())
  merchant_id  String
  title        String?
  caption      String
  image_url    String?
  product_id   String?
  is_published Boolean  @default(true)
  likes_count  Int      @default(0)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  merchant     Merchant @relation(fields: [merchant_id], references: [id], onDelete: Cascade)

  @@index([merchant_id, is_published, created_at])
  @@map("merchant_posts")
}

model VerificationPlan {
  id                 String                    @id @default(uuid())
  code               String                    @unique // MONTHLY, SEMI_ANNUAL, ANNUAL, etc.
  name               String
  description        String?
  duration_days      Int                       // 30, 180, 365
  price_tzs          Int
  is_active          Boolean                   @default(true)
  auto_renew_enabled Boolean                   @default(false)
  display_order      Int                       @default(0)
  created_at         DateTime                  @default(now())
  updated_at         DateTime                  @updatedAt

  applications       VerificationApplication[]

  @@index([is_active, display_order])
  @@map("verification_plans")
}

model VerificationApplication {
  id                    String            @id @default(uuid())
  merchant_id           String
  plan_id               String?
  method                String            @default("PAID") // PAID, ADMIN_GRANTED
  status                String            @default("PAYMENT_PENDING") // NOT_VERIFIED, PAYMENT_PENDING, PAID_PENDING_REVIEW, VERIFIED, REJECTED, EXPIRED, SUSPENDED
  payment_status        String            @default("PENDING") // PENDING, SUCCESSFUL, FAILED, CANCELLED, EXPIRED, REFUNDED
  payment_amount_tzs    Int               @default(0)
  transaction_reference String            @unique
  gateway_session_id    String?
  gateway_reference     String?
  checkout_url          String?
  payment_link_url      String?
  customer_phone        String?
  paid_at               DateTime?
  reviewed_by           String?
  reviewed_at           DateTime?
  review_notes          String?
  activated_at          DateTime?
  expires_at            DateTime?
  created_at            DateTime          @default(now())
  updated_at            DateTime          @updatedAt

  merchant              Merchant          @relation(fields: [merchant_id], references: [id], onDelete: Cascade)
  plan                  VerificationPlan? @relation(fields: [plan_id], references: [id], onDelete: SetNull)

  @@index([merchant_id, status])
  @@index([payment_status])
  @@index([expires_at])
  @@map("verification_applications")
}

model SmsTemplate {
  id             String    @id @default(uuid())
  merchant_id    String?
  name           String
  promotion_type String    @default("GENERAL_ANNOUNCEMENT")
  body           String
  is_system      Boolean   @default(false)
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  merchant       Merchant? @relation(fields: [merchant_id], references: [id], onDelete: Cascade)

  @@index([merchant_id])
  @@index([is_system])
  @@map("sms_templates")
}

model SmsCampaign {
  id                 String                 @id @default(uuid())
  merchant_id        String
  name               String
  promotion_type     String
  message_body       String
  status             String                 @default("DRAFT") // DRAFT, QUEUED, PROCESSING, SENT, PARTIALLY_DELIVERED, COMPLETED, FAILED, CANCELLED
  total_recipients   Int                    @default(0)
  estimated_units    Int                    @default(0)
  estimated_cost_tzs Int                    @default(0)
  total_units_used   Int                    @default(0)
  total_cost_tzs     Int                    @default(0)
  sent_count         Int                    @default(0)
  failed_count       Int                    @default(0)
  created_by         String?
  confirmed_at       DateTime?
  started_at         DateTime?
  completed_at       DateTime?
  created_at         DateTime               @default(now())
  updated_at         DateTime               @updatedAt

  merchant           Merchant               @relation(fields: [merchant_id], references: [id], onDelete: Cascade)
  recipients         SmsCampaignRecipient[]

  @@index([merchant_id, created_at])
  @@index([status])
  @@map("sms_campaigns")
}

model SmsCampaignRecipient {
  id                  String      @id @default(uuid())
  campaign_id         String
  merchant_id         String
  customer_id         String
  customer_name       String
  recipient_phone     String
  rendered_message    String
  units               Int         @default(1)
  status              String      @default("PENDING") // PENDING, SENT, FAILED, SKIPPED
  provider_message_id String?
  failure_reason      String?
  sent_at             DateTime?
  created_at          DateTime    @default(now())

  campaign            SmsCampaign @relation(fields: [campaign_id], references: [id], onDelete: Cascade)
  merchant            Merchant    @relation(fields: [merchant_id], references: [id], onDelete: Cascade)

  @@unique([campaign_id, customer_id])
  @@index([campaign_id, status])
  @@index([merchant_id, created_at])
  @@map("sms_campaign_recipients")
}

model MerchantNotification {
  id                String    @id @default(uuid())
  merchant_id       String
  order_id          String?
  notification_type String    @default("NEW_ORDER") // NEW_ORDER, ORDER_UPDATE, SYSTEM
  title             String
  message           String
  product_summary   String?
  action_url        String?
  read_at           DateTime?
  sms_status        String    @default("PENDING") // PENDING, PROCESSING, SENT, DELIVERED, FAILED
  delivery_attempts Int       @default(0)
  provider_response String?
  idempotency_key   String    @unique
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt

  merchant          Merchant  @relation(fields: [merchant_id], references: [id], onDelete: Cascade)
  order             Order?    @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@index([merchant_id, read_at, created_at])
  @@index([order_id])
  @@map("merchant_notifications")
}




